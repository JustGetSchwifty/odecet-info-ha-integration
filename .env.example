# Sign-in page for odecet.info. The client loads this page, reads the
# antiforgery token, and posts the login form back to it.
ODECET_INFO_SIGNIN_URL=https://odecet.info/signin

# Account email. Leave empty in the example. Put the real value only in .env.
ODECET_INFO_USERNAME=

# Account password. Leave empty in the example. Put the real value only in .env.
ODECET_INFO_PASSWORD=
